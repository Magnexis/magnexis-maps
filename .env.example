# Magnexis Maps — local development environment
# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_SECRET=dev-only-change-me-use-long-random-string
SESSION_COOKIE_NAME=magnexis_session

# --- Google OAuth (Sign in with Google) ---
# Create an OAuth 2.0 Web client in Google Cloud Console → APIs & Services → Credentials.
# Authorized JavaScript origins: http://localhost:3000 (and your production web origin).
# The API verifies Google ID tokens; the web app uses GIS One Tap / prompt.
# GOOGLE_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=   # same client id for the browser GIS script

# --- GitHub OAuth (Sign in with GitHub) ---
# Create an OAuth App under the Magnexis org (or your user): Settings → Developer settings → OAuth Apps.
# Homepage URL: http://localhost:3000 (and production web origin).
# Authorization callback URL: http://localhost:3000/auth/github/callback
# Also add production: https://<your-site>/auth/github/callback
# Client ID is public; Client Secret stays on the API only.
# GITHUB_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=   # same client id for the browser redirect
# GITHUB_OAUTH_CLIENT_SECRET=

# --- GitLab OAuth (Sign in with GitLab.com) ---
# Create a confidential application in GitLab: Edit profile → Access → Applications.
# Redirect URI: http://localhost:3000/auth/gitlab/callback
# Also add production: https://<your-site>/auth/gitlab/callback
# Request only the read_user scope. Client Secret stays on the API only.
# GITLAB_OAUTH_CLIENT_ID=
# NEXT_PUBLIC_GITLAB_OAUTH_CLIENT_ID=   # same client id for the browser redirect
# GITLAB_OAUTH_CLIENT_SECRET=

# --- Database (PostGIS) ---
DATABASE_URL=postgresql://magnexis:magnexis@localhost:5433/magnexis_maps
POSTGRES_USER=magnexis
POSTGRES_PASSWORD=magnexis
POSTGRES_DB=magnexis_maps
POSTGRES_PORT=5433

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Web (Next.js) / Netlify ---
# On Netlify, set these in Site configuration → Environment variables (not in git).
NEXT_PUBLIC_API_URL=http://localhost:4000
# OpenFreeMap = free OSM vector tiles (roads + labels, no API key).
# MapLibre demotiles are low-detail landcover only — avoid for UI review.
# Liberty (not OFM dark): shields, POIs, admin boundaries. Chromatic paints night colors.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_DEFAULT_CENTER_LNG=-72.6851
NEXT_PUBLIC_DEFAULT_CENTER_LAT=41.599998
NEXT_PUBLIC_DEFAULT_ZOOM=8
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors | © OpenFreeMap | © Magnexis Maps

# --- Mobile (Expo Go) ---
# Use your machine LAN IP when testing on a physical device (not localhost).
EXPO_PUBLIC_API_URL=http://localhost:4000

# Basemap (API) — OpenFreeMap OpenMapTiles; never use demotiles.maplibre.org
# Night/dark must use liberty (OFM dark omits highway shields + POI icons).
MAP_STYLE_STANDARD=https://tiles.openfreemap.org/styles/liberty
MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/liberty
# MAP_TILE_PROVIDER=openfreemap

# --- Terrain & satellite (licensed / API key required) ---
# Option A — MapTiler (easiest): create a free key at https://cloud.maptiler.com/
# Then set either MAPTILER_KEY (API) or NEXT_PUBLIC_MAPTILER_KEY (web).
# resolveMapStyles() will enable:
#   terrain  → https://api.maptiler.com/maps/outdoor-v4/style.json?key=…
#   satellite → https://api.maptiler.com/maps/satellite-v4/style.json?key=…
#   (Labels are applied by the shared liberty label pipeline after style.load —
#    do not rely on MapTiler hybrid alone; satellite-v4 hides its own labels.)
# MAPTILER_KEY=
# NEXT_PUBLIC_MAPTILER_KEY=
# EXPO_PUBLIC_MAPTILER_KEY=   # mobile (same key on free plan)

# Option B — explicit style JSON URLs (any MapLibre-compatible provider):
# MAP_STYLE_TERRAIN=https://api.maptiler.com/maps/outdoor-v4/style.json?key=YOUR_KEY
# MAP_STYLE_SATELLITE=https://api.maptiler.com/maps/satellite-v4/style.json?key=YOUR_KEY
# Other providers: Stadia Alidade Satellite, Mapbox satellite-v9 (requires Mapbox token),
# Thunderforest Landscape, etc. — paste their MapLibre style.json URL above.

# --- TomTom (recommended commercial stack) ---
# Secure entry (interactive, does not echo the key):
#   pnpm secrets:tomtom
# Or paste once into this file — never commit .env, never put the key in chat.
#
# Server-only key (routing, search, reverse geocode, traffic tile proxy):
# TOMTOM_API_KEY=
#
# When TOMTOM_API_KEY is set, prefer:
#   ROUTING_PROVIDER=tomtom
#   GEOCODING_PROVIDER=tomtom
#   NEXT_PUBLIC_TOMTOM_TRAFFIC_PROXY=1
# Traffic overlay then uses /api/v1/tiles/tomtom/traffic/… (key stays on the API).
#
# Do NOT put the same production key in NEXT_PUBLIC_* unless you accept browser
# exposure. If you must, create a separate TomTom key locked to your domains.
# NEXT_PUBLIC_TOMTOM_KEY=
# NEXT_PUBLIC_TOMTOM_TRAFFIC_PROXY=1

# --- Geocoding (do NOT use public Nominatim for autocomplete/production) ---
# GEOCODING_PROVIDER=none|photon|pelias|maptiler|tomtom|google|auto
GEOCODING_PROVIDER=maptiler
# GEOCODING_API_URL=
# GEOCODING_API_KEY=

# --- Routing ---
# tomtom | osrm | valhalla | auto | none
ROUTING_PROVIDER=osrm
# OSRM_URL=https://router.project-osrm.org
# ROUTING_PROVIDER=valhalla
# VALHALLA_URL=http://localhost:8002

# --- Live traffic (optional; never invented) ---
# Prefer TomTom proxy above. Other options:
# NEXT_PUBLIC_MAPBOX_TOKEN=
# NEXT_PUBLIC_TRAFFIC_TILES_URL=https://…/tiles.json?key=…  OR  …/{z}/{x}/{y}.pbf
# NEXT_PUBLIC_MAPTILER_TRAFFIC=1
# NEXT_PUBLIC_MAPTILER_TRAFFIC_TILESET=traffic
# NEXT_PUBLIC_TRAFFIC_SOURCE_LAYER=traffic
# NEXT_PUBLIC_TRAFFIC_CONGESTION_PROP=congestion

# --- Street view (Mapillary) ---
# Register an app: https://www.mapillary.com/dashboard/developers
# Use the Client Access Token (safe for NEXT_PUBLIC_*).
# NEXT_PUBLIC_MAPILLARY_ACCESS_TOKEN=
# Then enable “Street view” under Map appearance and click green coverage dots.

# --- Google Maps Platform (enrichment — MapLibre stays the basemap) ---
# Secure entry (interactive, does not echo the key):
#   pnpm secrets:google
#
# Server-only key (Places photos + Street View Static proxy + optional Geocoding):
# GOOGLE_MAPS_API_KEY=
# Alias also accepted: GOOGLE_PLACES_API_KEY=
#
# Place-photo order vs Mapillary: before | after  (default before)
# GOOGLE_PLACE_PHOTO_PRIORITY=before
#
# Google Cloud Console setup:
#   1. Create/select a project → enable Billing
#   2. APIs & Services → Enable:
#        - Places API (New)          # place photos / nearby / text search
#        - Street View Static API    # Street button fallback when Mapillary misses
#        - Maps Static API           # optional; Street View Static is enough for street
#        - Geocoding API             # only if GEOCODING_PROVIDER=google or auto fallback
#   3. Credentials → Create API key → Restrict:
#        - Application: IP addresses for the API server (recommended)
#        - Or HTTP referrers ONLY if you must expose a browser key
#          (http://localhost:3000/* and https://your-production-domain/*)
#        - API restrictions: limit to the APIs listed above
#   4. Never commit the key. Prefer the Magnexis API proxies:
#        GET /api/v1/providers/google/status
#        GET /api/v1/google/place-photo?lng=&lat=&name=
#        GET /api/v1/google/street-view?lng=&lat=
#
# Do NOT set NEXT_PUBLIC_GOOGLE_MAPS_API_KEY for production — the web app calls
# the API proxy so the key stays server-side (same pattern as TomTom traffic).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Object storage (evidence uploads) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Rate limits ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
GUEST_REPORT_RATE_LIMIT_MAX=5

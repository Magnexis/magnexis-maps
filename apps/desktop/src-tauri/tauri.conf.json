{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magnexis Maps",
  "version": "1.0.0",
  "identifier": "com.magnexis.maps",
  "build": {
    "frontendDist": "../../web/.next-web",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @magnexis/web dev",
    "beforeBuildCommand": "node scripts/build-frontend.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Magnexis Maps",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
